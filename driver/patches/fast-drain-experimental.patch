+#include <linux/vmalloc.h>
+#include <linux/ktime.h>
+/* Bounded experimental capture of DMA BB-scope reports; no packet injection. */
+#define IQ_SCOPE_LIMIT (128 * 1024 * 1024)
+static u8 *iq_scope_data;
+static u32 iq_scope_used;
+static u64 iq_scope_packets, iq_scope_dropped;
+static u64 iq_desc_total, iq_desc_scope, iq_core_total;
+void rtw89_iq_observe(unsigned int stage, unsigned int type)
+{
+    if (stage == 0) { iq_desc_total++; if (type == 3) iq_desc_scope++; }
+    else iq_core_total++;
+}
+EXPORT_SYMBOL_GPL(rtw89_iq_observe);
+static DEFINE_SPINLOCK(iq_scope_lock);
+static bool iq_live_mode;
+static u32 iq_live_head, iq_live_tail, iq_live_count;
+static void iq_live_append(const void *data, u32 len)
+{
+    u32 first = min_t(u32, len, IQ_SCOPE_LIMIT - iq_live_head);
+    memcpy(iq_scope_data + iq_live_head, data, first);
+    memcpy(iq_scope_data, (const u8 *)data + first, len - first);
+    iq_live_head = (iq_live_head + len) % IQ_SCOPE_LIMIT;
+    iq_live_count += len;
+}
+
+void rtw89_scope_record(struct sk_buff *skb, struct rtw89_rx_desc_info *desc)
+{
+    unsigned long flags;
+    __le32 hdr[6];
+    u64 now = ktime_get_mono_fast_ns();
+    hdr[0] = cpu_to_le32(skb->len);
+    hdr[1] = cpu_to_le32(desc->free_run_cnt);
+    hdr[2] = cpu_to_le32(desc->seq | (desc->bb_sel << 16));
+    hdr[3] = cpu_to_le32(desc->pkt_size);
+    hdr[4] = cpu_to_le32((u32)now);
+    hdr[5] = cpu_to_le32(now >> 32);
+    spin_lock_irqsave(&iq_scope_lock, flags);
+    iq_scope_packets++;
+    if (iq_live_mode) {
+        if (iq_scope_data && iq_live_count + sizeof(hdr) + skb->len <= IQ_SCOPE_LIMIT) {
+            iq_live_append(hdr, sizeof(hdr)); iq_live_append(skb->data, skb->len);
+        } else { iq_scope_dropped++; }
+        spin_unlock_irqrestore(&iq_scope_lock, flags);
+        return;
+    }
+    if (iq_scope_data && iq_scope_used + sizeof(hdr) + skb->len <= IQ_SCOPE_LIMIT) {
+        memcpy(iq_scope_data + iq_scope_used, hdr, sizeof(hdr));
+        iq_scope_used += sizeof(hdr);
+        memcpy(iq_scope_data + iq_scope_used, skb->data, skb->len);
+        iq_scope_used += skb->len;
+    } else {
+        iq_scope_dropped++;
+    }
+    spin_unlock_irqrestore(&iq_scope_lock, flags);
+}
+
+/* Consuming FIFO reader; EAGAIN permits a userspace producer/consumer loop. */
+static ssize_t iq_drain_read(struct file *file, char __user *buf, size_t count, loff_t *pos)
+{
+    unsigned long flags;
+    u32 len, first;
+    u8 *temp;
+    if (!count) return 0;
+    if (!iq_scope_data) return -ENOMEM;
+    count = min_t(size_t, count, 65536);
+    temp = kmalloc(count, GFP_KERNEL);
+    if (!temp) return -ENOMEM;
+    spin_lock_irqsave(&iq_scope_lock, flags);
+    len = min_t(u32, count, iq_live_count);
+    first = min_t(u32, len, IQ_SCOPE_LIMIT - iq_live_tail);
+    memcpy(temp, iq_scope_data + iq_live_tail, first);
+    memcpy(temp + first, iq_scope_data, len - first);
+    iq_live_tail = (iq_live_tail + len) % IQ_SCOPE_LIMIT;
+    iq_live_count -= len;
+    spin_unlock_irqrestore(&iq_scope_lock, flags);
+    if (!len) { kfree(temp); return -EAGAIN; }
+    if (copy_to_user(buf, temp, len)) { kfree(temp); return -EFAULT; }
+    kfree(temp); return len;
+}
+static ssize_t iq_drain_write(struct file *file, const char __user *buf, size_t count, loff_t *pos)
+{
+    unsigned long flags;
+    if (!iq_scope_data) return -ENOMEM;
+    spin_lock_irqsave(&iq_scope_lock, flags);
+    iq_live_head = iq_live_tail = iq_live_count = 0;
+    iq_scope_used = iq_scope_packets = iq_scope_dropped = 0;
+    iq_live_mode = true;
+    spin_unlock_irqrestore(&iq_scope_lock, flags);
+    return count;
+}
+static const struct file_operations iq_drain_fops = {
+    .owner = THIS_MODULE, .read = iq_drain_read, .write = iq_drain_write,
+    .llseek = no_llseek,
+};
+
+static ssize_t iq_scope_read(struct file *file, char __user *buf,
+                            size_t count, loff_t *pos)
+{
+    if (READ_ONCE(iq_live_mode)) return -EBUSY;
+    return simple_read_from_buffer(buf, count, pos, iq_scope_data, READ_ONCE(iq_scope_used));
+}
+static ssize_t iq_scope_reset(struct file *file, const char __user *buf,
+                             size_t count, loff_t *pos)
+{
+    unsigned long flags;
+    spin_lock_irqsave(&iq_scope_lock, flags);
+    iq_scope_used = 0; iq_scope_packets = 0; iq_scope_dropped = 0;
+    spin_unlock_irqrestore(&iq_scope_lock, flags);
+    return count;
+}
+static const struct file_operations iq_scope_fops = {
+    .owner = THIS_MODULE, .read = iq_scope_read, .write = iq_scope_reset,
+    .llseek = default_llseek,
+};
