+/* Only map an allocation still owned by this producer. Check every link;
+ * packet IDs do not imply physical contiguity. Fall back to virtual DMA. */
+static u32 iq_owned_physical(struct rtw89_dev *rtwdev, u16 id, u32 bytes)
+{
+    struct rtw89_mac_dle_dfi_ctrl dfi = {
+        .type = DLE_CTRL_TYPE_PLE, .target = DLE_DFI_TYPE_PAGELLT,
+    };
+    u32 pages = DIV_ROUND_UP(bytes + 24, 128), i;
+    if (id + pages > 1089) return 0;
+    for (i = 0; i < pages; ++i) {
+        dfi.addr = id + i;
+        if (rtw89_mac_dle_dfi_cfg(rtwdev, &dfi) ||
+            (dfi.out_data & 0xfff) != (i + 1 == pages ? 0xfff : id + i + 1))
+            return 0;
+    }
+    return 0x18766000 + id * 128 + 24;
+}
+
+/* Raw LA -> IDDMA channel 5 -> owned PLE -> host dispatch. */
+static u32 iq_chunk_bytes = 8192, iq_sample_rate = 5000000;
+static atomic_t iq_stream_claimed = ATOMIC_INIT(0);
+static bool iq_stop, iq_running, iq_physical, iq_pipeline, iq_dual;
+/* Release the global wireless mutex only between completed DMA copies.
+ * rfkill/regulatory workers can otherwise hold RTNL while waiting for us,
+ * delaying unrelated network operations for the entire SDR acquisition.
+ * Restore the shared MMIO aperture before unlocking, then sample its new
+ * idle value after reacquiring it. Existing elapsed/ring guards cover waits.
+ */
+struct iq_stalls { u64 max_gap, last_gap, max_yield, last_yield; u32 reason; };
+static u64 iq_stream_yield(struct rtw89_dev *rtwdev, u32 *filter, u64 *deadline, struct iq_stalls *stats)
+{
+    u64 now=ktime_get_ns();
+    if(now<*deadline) return now;
+    rtw89_write32(rtwdev,0xc04,*filter);
+    wiphy_unlock(rtwdev->hw->wiphy);
+    /* A deadline task can starve CFS ksoftirqd even at cond_resched().
+     * No IDDMA copy is active here; leave a bounded RX-service window. */
+    if(current->policy==SCHED_DEADLINE) usleep_range(25,50);
+    else cond_resched();
+    wiphy_lock(rtwdev->hw->wiphy);
+    *filter=rtw89_read32(rtwdev,0xc04);
+    rtw89_write32(rtwdev,0xc04,0x18008000);
+    if(stats) { stats->last_yield=ktime_get_ns()-now; stats->max_yield=max(stats->max_yield,stats->last_yield); }
+    now=ktime_get_ns(); *deadline=now+2000000;
+    return now;
+}
+static ssize_t iq_stream_serial(struct file *file, const char __user *buf, size_t count, loff_t *pos)
+{
+    struct rtw89_dev *rtwdev = file->private_data;
+    struct rtw89_cpuio_ctrl queue = { .cmd_type = CPUIO_OP_CMD_ENQ_TO_TAIL };
+    u32 filter, dma_old[3], ctrl, monitor = 0, addr, aperture, state;
+    u32 last = 0, wp, rp = 0, backlog = 0, max_backlog = 0;
+    u32 produced = 0, consumed = 0, packets = 0, loss, headers[6];
+    u16 id;
+    u32 failure_stage=0, end_la, end_wp, end_dma, end_status;
+    u32 physical = 0, physical_packets = 0;
+    u64 validation_ns = 0;
+    bool use_physical = READ_ONCE(iq_physical);
+    int ret = 0, i;
+    u64 start, elapsed, end, stamp, timing[4] = {}, last_poll, poll_limit, yield_at;
+    u32 sample_rate=READ_ONCE(iq_sample_rate);
+    unsigned int ms, bytes = READ_ONCE(iq_chunk_bytes), records = bytes / 8;
+    char text[24];
+    if (count >= sizeof(text) || copy_from_user(text, buf, count)) return -EINVAL;
+    text[count] = 0;
+    if (kstrtouint(text, 0, &ms) || (ms && ms < 10) || ms > 60000) return -EINVAL;
+    if (bytes != 4096 && bytes != 8192) return -EINVAL;
+    if (!sample_rate || sample_rate > 160000000) return -EINVAL;
+    if (atomic_cmpxchg(&iq_stream_claimed,0,1)) return -EBUSY;
+    wiphy_lock(rtwdev->hw->wiphy);
+    WRITE_ONCE(iq_stop, false); WRITE_ONCE(iq_running, true);
+    filter = rtw89_read32(rtwdev, 0xc04);
+    rtw89_write32(rtwdev, 0xc04, 0x18008000);
+    for (i = 0; i < 3; ++i) dma_old[i] = rtw89_read32(rtwdev, 0x80050 + 4*i);
+    if ((dma_old[2] & BIT(31)) || dma_old[2] == 0xdeadbeef || (rtw89_read32(rtwdev, 0x800e8) & BIT(5))) { ret = -EBUSY; goto finish; }
+    rtw89_write32(rtwdev, 0x9668, 0);
+    rtw89_write32(rtwdev, 0x9660, (4<<16)|(11<<8)|1);
+    start = ktime_get_ns(); end = start + (u64)ms * 1000000;
+    last_poll=start; yield_at=start+2000000; poll_limit=40960ULL*900000000ULL/sample_rate;
+    rtw89_write32(rtwdev, 0x9660, (4<<16)|(11<<8)|9);
+    while (!READ_ONCE(iq_stop) && (!ms || ktime_get_ns() < end)) {
+        stamp=iq_stream_yield(rtwdev,&filter,&yield_at,NULL);
+        if (stamp-last_poll >= poll_limit) { failure_stage=5; ret=-EOVERFLOW; break; }
+        last_poll=stamp;
+        if (fatal_signal_pending(current)) { ret=-EINTR; break; }
+        state = rtw89_read32(rtwdev, 0x9664); wp = state & 0xffff;
+        if (((state >> 17) & 7) != 1) { failure_stage=4; ret = -EIO; break; }
+        if (wp >= 40960) { ret = -ERANGE; break; }
+        produced += (wp + 40960 - last) % 40960; last = wp;
+        backlog = produced - consumed;
+        if (backlog > max_backlog) max_backlog = backlog;
+        if (backlog >= 40960) { failure_stage=6; ret = -EOVERFLOW; break; }
+        if (backlog < records) { udelay(2); cond_resched(); continue; }
+        stamp = ktime_get_ns();
+        ret = iq_dle_req(rtwdev, bytes + 24, false, &id);
+        if (ret) { failure_stage=1; break; }
+        timing[0] += ktime_get_ns()-stamp; stamp = ktime_get_ns();
+        if (use_physical) {
+            physical = iq_owned_physical(rtwdev, id, bytes);
+            validation_ns += ktime_get_ns()-stamp; stamp = ktime_get_ns();
+            if (physical) physical_packets++;
+        }
+        addr = 0x08000000 | (id << 15); aperture = 0x80000 + (addr & 0x7ffff);
+        rtw89_write32(rtwdev, 0xc04, addr & ~0x7ffff);
+        headers[0] = (3<<24)|bytes; headers[1] = id|(8<<16);
+        headers[2] = 0; headers[3] = 0; headers[4] = 0; headers[5] = consumed;
+        for (i=0; i<6; ++i) rtw89_write32(rtwdev, aperture+4*i, headers[i]);
+        rtw89_write32(rtwdev, 0xc04, 0x18008000);
+        rtw89_write32(rtwdev, 0x80050, 0x18716000+rp*8);
+        rtw89_write32(rtwdev, 0x80054, physical ? physical : addr+24);
+        rtw89_write32(rtwdev, 0x80058, BIT(31)|bytes);
+        timing[1] += ktime_get_ns()-stamp; stamp = ktime_get_ns();
+        ret = read_poll_timeout_atomic(rtw89_read32, ctrl, !(ctrl & BIT(31)), 1, 1000, false, rtwdev, 0x80058);
+        timing[2] += ktime_get_ns()-stamp; stamp = ktime_get_ns();
+        monitor = rtw89_read32(rtwdev, 0x800fc);
+        if (ret) { failure_stage=2; break; } /* Keep ownership if DMA has not finished; reset on unload. */
+        /* Do not forward a block that the LA writer lapped during copy. */
+        state = rtw89_read32(rtwdev, 0x9664); wp = state & 0xffff;
+        stamp = ktime_get_ns();
+        if (wp >= 40960 || stamp-last_poll >= poll_limit) ret=-EOVERFLOW;
+        else {
+            produced += (wp+40960-last)%40960; last=wp; last_poll=stamp;
+            if (produced-consumed >= 40960) ret=-EOVERFLOW;
+            else if (((state>>17)&7)!=1) ret=-EIO;
+        }
+        queue.start_pktid = id; queue.end_pktid = id;
+        queue.dst_pid = ret ? PLE_DLE_PORT_ID_PLRLS : PLE_DLE_PORT_ID_DISPATCH;
+        queue.dst_qid = 0;
+        if (!ret) rtw89_write32(rtwdev, 0x800e4, BIT(5));
+        i = iq_set_cpuio(rtwdev, &queue, false);
+        if (ret || i) { failure_stage=ret?7:3; if (!ret) ret = i; break; }
+        timing[3] += ktime_get_ns()-stamp;
+        consumed += records; rp = (rp+records)%40960; packets++;
+        cond_resched();
+    }
+    elapsed = ktime_get_ns()-start;
+    end_la=rtw89_read32(rtwdev,0x9660); end_wp=rtw89_read32(rtwdev,0x9664);
+    end_dma=rtw89_read32(rtwdev,0x80058); end_status=rtw89_read32(rtwdev,0x800e8);
+    rtw89_write32(rtwdev, 0x9660, (4<<16)|(11<<8));
+    loss = rtw89_read32(rtwdev, 0x966c);
+    snprintf(iq_cpuio_result,sizeof(iq_cpuio_result),"ret=%d packets=%u produced=%u consumed=%u max_backlog=%u elapsed_ns=%llu loss=0x%x monitor=0x%x stages_ns=%llu,%llu,%llu,%llu physical=%u validation_ns=%llu fault_stage=%u last_state=%x end_la=%x end_wp=%x end_dma=%x end_status=%x host_packets=%llu host_drops=%llu\n",ret,packets,produced,consumed,max_backlog,elapsed,loss,monitor,timing[0],timing[1],timing[2],timing[3],physical_packets,validation_ns,failure_stage,state,end_la,end_wp,end_dma,end_status,READ_ONCE(iq_scope_packets),READ_ONCE(iq_scope_dropped));
+finish:
+    rtw89_write32(rtwdev, 0xc04, 0x18008000);
+    if (!(rtw89_read32(rtwdev, 0x80058) & BIT(31)))
+        for (i=0; i<3; ++i) rtw89_write32(rtwdev,0x80050+4*i,dma_old[i]);
+    rtw89_write32(rtwdev, 0xc04, filter);
+    wiphy_unlock(rtwdev->hw->wiphy);
+    WRITE_ONCE(iq_running, false);
+    atomic_set(&iq_stream_claimed,0);
+    return ret == -EBUSY ? ret : count;
+}
+/* Packet preparation and host dispatch overlap IDDMA; never enqueue an
+ * unfinished copy or write a packet after dispatch transfers ownership. */
+static void iq_header_packet(struct rtw89_dev *rtwdev, u32 bytes, u32 seq, u16 id)
+{
+    u32 addr=0x08000000|(id<<15), aperture=0x80000+(addr&0x7ffff), h[6];
+    int i;
+    rtw89_write32(rtwdev,0xc04,addr&~0x7ffff);
+    h[0]=(3<<24)|bytes; h[1]=id|(8<<16); h[2]=h[3]=h[4]=0; h[5]=seq;
+    for(i=0;i<6;i++) rtw89_write32(rtwdev,aperture+4*i,h[i]);
+    rtw89_write32(rtwdev,0xc04,0x18008000);
+}
+static int iq_prepare_packet(struct rtw89_dev *rtwdev, u32 bytes, u32 seq, u16 *id)
+{
+    int ret=iq_dle_req(rtwdev,bytes+24,false,id);
+    if(!ret) iq_header_packet(rtwdev,bytes,seq,*id);
+    return ret;
+}
+
+static int iq_dispatch_packet(struct rtw89_dev *rtwdev, u16 id, bool release)
+{
+    struct rtw89_cpuio_ctrl q = {
+        .cmd_type=CPUIO_OP_CMD_ENQ_TO_TAIL,
+        .start_pktid=id, .end_pktid=id,
+        .dst_pid=release ? PLE_DLE_PORT_ID_PLRLS : PLE_DLE_PORT_ID_DISPATCH,
+        .dst_qid=0,
+    };
+    return iq_set_cpuio(rtwdev,&q,false);
+}
+
+static ssize_t iq_stream_pipeline(struct file *file, const char __user *buf, size_t count, loff_t *pos)
+{
+    struct rtw89_dev *rtwdev=file->private_data;
+    u32 filter, dma4_old[3]={}, dma_old[3], ctrl=0, state, last=0, wp, rp=0;
+    u32 produced=0, consumed=0, packets=0, backlog=0, max_backlog=0;
+    u32 raw_rate=READ_ONCE(iq_sample_rate), bytes=READ_ONCE(iq_chunk_bytes), records=bytes/8;
+    u16 id=0, previous_id=0, next_id=0;
+    bool dual=READ_ONCE(iq_dual), owned=false, previous=false, next_owned=false, dma_active=false, started=false;
+    u64 start=ktime_get_ns(), end, now, last_poll, poll_limit, stamp, yield_at, timing[4]={};
+    int ret=0, next_ret=0, i, queued;
+    u32 snap[7]={};
+    struct iq_stalls stats={};
+    unsigned int ms;
+    char text[24];
+    if(count>=sizeof(text)||copy_from_user(text,buf,count)) return -EINVAL;
+    text[count]=0;
+    if(kstrtouint(text,0,&ms)||(ms&&ms<10)||ms>60000) return -EINVAL;
+    if((bytes!=4096&&bytes!=8192&&bytes!=10240)||!raw_rate||raw_rate>160000000) return -EINVAL;
+    if(atomic_cmpxchg(&iq_stream_claimed,0,1)) return -EBUSY;
+    wiphy_lock(rtwdev->hw->wiphy);
+    WRITE_ONCE(iq_stop,false); WRITE_ONCE(iq_running,true);
+    filter=rtw89_read32(rtwdev,0xc04);
+    rtw89_write32(rtwdev,0xc04,0x18008000);
+    for(i=0;i<3;i++) dma_old[i]=rtw89_read32(rtwdev,0x80050+4*i);
+    if((dma_old[2]&BIT(31))||dma_old[2]==0xdeadbeef||(rtw89_read32(rtwdev,0x800e8)&BIT(5))) {
+        ret=-EBUSY; goto finish;
+    }
+    if (dual) {
+        for(i=0;i<3;i++) dma4_old[i]=rtw89_read32(rtwdev,0x80040+4*i);
+        if ((dma4_old[2]&BIT(31)) || (rtw89_read32(rtwdev,0x800e8)&BIT(4))) { ret=-EBUSY; dual=false; goto finish; }
+    }
+    ret=iq_prepare_packet(rtwdev,bytes,0,&id);
+    if(ret) goto finish;
+    owned=true;
+    rtw89_write32(rtwdev,0x9668,0);
+    rtw89_write32(rtwdev,0x9660,(4<<16)|(11<<8)|1);
+    start=ktime_get_ns(); end=start+(u64)ms*1000000;
+    last_poll=start; yield_at=start+2000000; poll_limit=40960ULL*900000000ULL/raw_rate;
+    rtw89_write32(rtwdev,0x9660,(4<<16)|(11<<8)|9); started=true;
+    while(!READ_ONCE(iq_stop)&&(!ms||ktime_get_ns()<end)) {
+        now=iq_stream_yield(rtwdev,&filter,&yield_at,&stats);
+        stats.last_gap=now-last_poll; stats.max_gap=max(stats.max_gap,stats.last_gap);
+        if(now-last_poll>=poll_limit) { stats.reason=1; ret=-EOVERFLOW; break; }
+        last_poll=now;
+        if(fatal_signal_pending(current)) { ret=-EINTR; break; }
+        state=rtw89_read32(rtwdev,0x9664); wp=state&0xffff;
+        if(((state>>17)&7)!=1) { ret=-EIO; break; }
+        if(wp>=40960) { ret=-ERANGE; break; }
+        produced+=(wp+40960-last)%40960; last=wp;
+        backlog=produced-consumed; max_backlog=max(backlog,max_backlog);
+        if(backlog>=40960) { stats.reason=2; ret=-EOVERFLOW; break; }
+        if(backlog<records) { udelay(2); cond_resched(); continue; }
+        stamp=ktime_get_ns();
+        if (dual) {
+            rtw89_write32(rtwdev,0x80040,0x18716000+rp*8);
+            rtw89_write32(rtwdev,0x80044,(0x08000000|(id<<15))+24);
+            rtw89_write32(rtwdev,0x80048,BIT(31)|(bytes/2));
+        }
+        rtw89_write32(rtwdev,0x80050,0x18716000+rp*8+(dual?bytes/2:0));
+        rtw89_write32(rtwdev,0x80054,(0x08000000|(id<<15))+24+(dual?bytes/2:0));
+        rtw89_write32(rtwdev,0x80058,BIT(31)|(dual?bytes/2:bytes)); dma_active=true;
+        timing[1]+=ktime_get_ns()-stamp; stamp=ktime_get_ns();
+        if(previous) {
+            queued=iq_dispatch_packet(rtwdev,previous_id,false);
+            previous=false; /* On timeout, ownership is uncertain; unload. */
+            if(queued) next_ret=queued; else packets++;
+        }
+        timing[3]+=ktime_get_ns()-stamp; stamp=ktime_get_ns();
+        if(!next_ret) {
+            next_ret=iq_dle_req(rtwdev,bytes+24,false,&next_id);
+            next_owned=!next_ret;
+        }
+        timing[0]+=ktime_get_ns()-stamp; stamp=ktime_get_ns();
+        ret=read_poll_timeout_atomic(rtw89_read32,ctrl,!(ctrl&BIT(31)),1,1000,false,rtwdev,0x80058);
+        if (!ret && dual) ret=read_poll_timeout_atomic(rtw89_read32,ctrl,!(ctrl&BIT(31)),1,1000,false,rtwdev,0x80048);
+        timing[2]+=ktime_get_ns()-stamp;
+        if(ret) break; /* Never free a packet while DMA may still be writing. */
+        dma_active=false; rtw89_write32(rtwdev,0x800e4,BIT(5)|(dual?BIT(4):0));
+        now=iq_stream_yield(rtwdev,&filter,&yield_at,&stats);
+        stats.last_gap=now-last_poll; stats.max_gap=max(stats.max_gap,stats.last_gap);
+        if(now-last_poll>=poll_limit) { stats.reason=3; ret=-EOVERFLOW; break; }
+        last_poll=now;
+        wp=rtw89_read32(rtwdev,0x9664)&0xffff;
+        if(wp>=40960) { ret=-ERANGE; break; }
+        produced+=(wp+40960-last)%40960; last=wp;
+        backlog=produced-consumed; max_backlog=max(backlog,max_backlog);
+        /* Source must not wrap onto a block during the copy itself. */
+        if(backlog>=40960) { stats.reason=4; ret=-EOVERFLOW; break; }
+        consumed+=records; rp=(rp+records)%40960;
+        previous_id=id; previous=true; owned=false;
+        if(next_ret) { ret=next_ret; break; }
+        id=next_id; owned=next_owned; next_owned=false;
+        iq_header_packet(rtwdev,bytes,consumed,id);
+        cond_resched();
+    }
+finish:
+    snap[0]=rtw89_read32(rtwdev,0x9660); snap[1]=rtw89_read32(rtwdev,0x9664);
+    snap[2]=rtw89_read32(rtwdev,0x3098); snap[3]=rtw89_read32(rtwdev,0x309c);
+    snap[4]=rtw89_read32(rtwdev,0x21090); snap[5]=rtw89_read32(rtwdev,0x20014); snap[6]=rtw89_read32(rtwdev,0x21094);
+    if(started) rtw89_write32(rtwdev,0x9660,(4<<16)|(11<<8));
+    if(previous) { queued=iq_dispatch_packet(rtwdev,previous_id,false); if(!queued) packets++; else if(!ret) ret=queued; }
+    if(owned&&!dma_active) iq_dispatch_packet(rtwdev,id,true);
+    if(next_owned) iq_dispatch_packet(rtwdev,next_id,true);
+    rtw89_write32(rtwdev,0xc04,0x18008000);
+    if(!(rtw89_read32(rtwdev,0x80058)&BIT(31)))
+        for(i=0;i<3;i++) rtw89_write32(rtwdev,0x80050+4*i,dma_old[i]);
+    if (dual && !(rtw89_read32(rtwdev,0x80048)&BIT(31)))
+        for(i=0;i<3;i++) rtw89_write32(rtwdev,0x80040+4*i,dma4_old[i]);
+    snprintf(iq_cpuio_result,sizeof(iq_cpuio_result),
+      "ret=%d pipeline=1 snap=%x,%x,%x,%x,%x,%x,%x packets=%u produced=%u consumed=%u max_backlog=%u elapsed_ns=%llu loss=0x%x stages_ns=%llu,%llu,%llu,%llu policy=%u reason=%u gap_ns=%llu,%llu yield_ns=%llu,%llu\n",
+      ret,snap[0],snap[1],snap[2],snap[3],snap[4],snap[5],snap[6],packets,produced,consumed,max_backlog,ktime_get_ns()-start,rtw89_read32(rtwdev,0x966c),timing[0],timing[1],timing[2],timing[3],current->policy,stats.reason,stats.max_gap,stats.last_gap,stats.max_yield,stats.last_yield);
+    {
+        const u32 addresses[]={0x21098,0x2109c,0x210a0,0x210b4,0x210b8,0x210bc,0x210e4,0x210e8,0x210f0,0x8428};
+        size_t used=strlen(iq_cpuio_result);
+        for(i=0;i<ARRAY_SIZE(addresses);i++)
+            used+=scnprintf(iq_cpuio_result+used,sizeof(iq_cpuio_result)-used," %x=%x",addresses[i],rtw89_read32(rtwdev,addresses[i]));
+    }
+    rtw89_write32(rtwdev,0xc04,filter);
+    wiphy_unlock(rtwdev->hw->wiphy);
+    WRITE_ONCE(iq_running,false); atomic_set(&iq_stream_claimed,0);
+    return ret==-EBUSY?ret:count;
+}
+
+static ssize_t iq_stream_write(struct file *file, const char __user *buf, size_t count, loff_t *pos)
+{
+    return READ_ONCE(iq_pipeline) ? iq_stream_pipeline(file,buf,count,pos) : iq_stream_serial(file,buf,count,pos);
+}
+
+static const struct file_operations iq_stream_fops = {
+    .owner=THIS_MODULE, .open=simple_open, .read=iq_cpuio_read,
+    .write=iq_stream_write, .llseek=default_llseek,
+};
